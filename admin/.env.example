# Admin Vite app — restart `npm run dev` after changes
# On LAN (http), localhost is rewritten to the page hostname

# Must include /api (admin paths are /api/auth, /api/admin, …)
VITE_API_BASE=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5001

# Production (Vercel): set these in the Vercel project env — HTTPS backend required
# VITE_API_BASE=https://your-backend.example.com/api
# VITE_SOCKET_URL=https://your-backend.example.com:5001
