# User (player) Vite app — restart `npm run dev` after changes
# localhost is auto-rewritten to the page hostname for LAN phones/PCs

VITE_API_BASE=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5001

# Provider Game SDK (optional — used when launched with sessionToken)
VITE_PROVIDER_API_URL=https://api.dpbossking.com/api/v1
